<Window x:Class="PulseOverlay.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:PulseOverlay"
        Title="Pulse Overlay"
        Icon="Assets/heart.ico"
        Width="1000" Height="680" MinWidth="880" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource PoBg}"
        Foreground="{StaticResource PoText}"
        FontFamily="Segoe UI Variable Text, Segoe UI">

    <Grid Margin="24,18,24,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ══════ HEADER ══════ -->
        <Grid Margin="0,0,0,16">
            <StackPanel Orientation="Horizontal">
                <Path Data="{StaticResource HeartGeometry}" Fill="{StaticResource PoAccent}" Width="26" Height="26"
                      Stretch="Uniform" VerticalAlignment="Center"/>
                <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="Pulse Overlay" FontSize="20" FontWeight="SemiBold"/>
                    <TextBlock Text="{local:L app.tagline}" Style="{StaticResource Muted}"/>
                </StackPanel>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Border Style="{StaticResource Chip}" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse x:Name="ServerDot" Width="8" Height="8" Fill="#6B7080" VerticalAlignment="Center"/>
                        <TextBlock x:Name="ServerText" Text="{local:L server.starting}" FontSize="12" Margin="8,0,0,0"
                                   VerticalAlignment="Center"/>
                        <TextBlock Text="·" Foreground="{StaticResource PoMuted}" Margin="8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{local:L obs.clients}" FontSize="12" Foreground="{StaticResource PoMuted}"
                                   VerticalAlignment="Center"/>
                        <TextBlock x:Name="ObsClients" Text="0" FontSize="12" FontWeight="SemiBold" Margin="5,0,0,0"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
                <ComboBox x:Name="LanguageBox" Margin="10,0,0,0" MinWidth="112" VerticalAlignment="Center"
                          ToolTip="{local:L lang.tip}" SelectionChanged="LanguageBox_SelectionChanged">
                    <ComboBoxItem Content="Türkçe" Tag="tr"/>
                    <ComboBoxItem Content="English" Tag="en"/>
                </ComboBox>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="18"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ══════ LEFT: live + saved watches ══════ -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Hero -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock x:Name="HeroName" Style="{StaticResource SectionTitle}"
                                       TextTrimming="CharacterEllipsis"/>
                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                <Path x:Name="HeroHeart" Data="{StaticResource HeartGeometry}" Fill="{StaticResource PoAccent}"
                                      Width="38" Height="38" Stretch="Uniform" VerticalAlignment="Center"
                                      RenderTransformOrigin="0.5,0.5" Opacity="0.35">
                                    <Path.RenderTransform>
                                        <ScaleTransform x:Name="HeroHeartScale"/>
                                    </Path.RenderTransform>
                                    <Path.Effect>
                                        <DropShadowEffect Color="#FF3B5C" BlurRadius="18" ShadowDepth="0" Opacity="0.6"/>
                                    </Path.Effect>
                                </Path>
                                <TextBlock x:Name="HeroBpm" Text="--" FontFamily="Bahnschrift" FontSize="76"
                                           FontWeight="SemiBold" Margin="16,-6,0,-6" VerticalAlignment="Center"/>
                                <TextBlock Text="BPM" FontFamily="Bahnschrift" FontSize="16" FontWeight="SemiBold"
                                           Foreground="{StaticResource PoAccent}" Margin="10,0,0,14"
                                           VerticalAlignment="Bottom"/>
                            </StackPanel>
                            <TextBlock x:Name="HeroStats" Text=" " Style="{StaticResource Muted}" Margin="0,4,0,0"/>
                            <TextBlock x:Name="HeroRecords" Text=" " Style="{StaticResource Muted}" Margin="0,3,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                            <Border x:Name="HeroChip" Style="{StaticResource Chip}" HorizontalAlignment="Right">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse x:Name="HeroDot" Width="8" Height="8" Fill="#6B7080" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="HeroState" FontSize="12" FontWeight="SemiBold"
                                               Margin="7,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                            <CheckBox x:Name="SimToggle" Content="{local:L sim.label}" Margin="0,14,0,0" HorizontalAlignment="Right"
                                      Checked="SimToggle_Checked" Unchecked="SimToggle_Unchecked"
                                      ToolTip="{local:L sim.tip}"/>
                            <Button Content="{local:L btn.newStream}" Style="{StaticResource SubtleAction}"
                                    Margin="0,8,0,0" HorizontalAlignment="Right" Click="ResetStats_Click"
                                    ToolTip="{local:L btn.newStream.tip}"/>
                            <Button Content="{local:L btn.resetRecord}" Style="{StaticResource SubtleAction}"
                                    Margin="0,6,0,0" HorizontalAlignment="Right" Click="ResetRecords_Click"
                                    ToolTip="{local:L btn.resetRecord.tip}"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Saved watches -->
                <Border Grid.Row="1" Style="{StaticResource Card}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <StackPanel Margin="0,0,0,10">
                            <TextBlock Text="{local:L saved.title}" Style="{StaticResource SectionTitle}"/>
                            <TextBlock Text="{local:L saved.subtitle}" Style="{StaticResource Muted}" Margin="0,2,0,0"/>
                        </StackPanel>
                        <TextBlock x:Name="EmptyRows" Grid.Row="1" Style="{StaticResource Muted}" Margin="0,8,0,0"
                                   Text="{local:L saved.empty}"/>
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <ItemsControl x:Name="DeviceRows">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{StaticResource PoInner}" CornerRadius="10" Padding="14,12"
                                                Margin="0,0,0,8">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>
                                                <Ellipse Width="10" Height="10" Fill="{Binding StateBrush}" VerticalAlignment="Center"/>
                                                <StackPanel Grid.Column="1" Margin="12,0,10,0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                                               ToolTip="{Binding Name}"/>
                                                    <TextBlock Text="{Binding StateText}" Style="{StaticResource Muted}" Margin="0,2,0,0"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding BpmText}" FontFamily="Bahnschrift" FontSize="26"
                                                               FontWeight="SemiBold"/>
                                                    <TextBlock Text="BPM" FontSize="10" Foreground="{StaticResource PoMuted}"
                                                               VerticalAlignment="Bottom" Margin="4,0,0,5"/>
                                                </StackPanel>
                                                <StackPanel Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Orientation="Horizontal"
                                                            HorizontalAlignment="Right" Margin="0,10,0,0"
                                                            Visibility="{Binding ControlsVisibility}">
                                                    <Button Content="{Binding ToggleText}" Style="{StaticResource SubtleAction}"
                                                            MinWidth="64" Click="ToggleConnection_Click"/>
                                                    <Button Content="{local:L row.overlayUrl}" Style="{StaticResource SubtleAction}"
                                                            Margin="6,0,0,0" Click="CopyDeviceUrl_Click"
                                                            ToolTip="{local:L row.overlayUrl.tip}"/>
                                                    <Button Content="{local:L row.forget}" Style="{StaticResource SubtleAction}"
                                                            Margin="6,0,0,0" Click="Forget_Click"
                                                            ToolTip="{local:L row.forget.tip}"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>

            <!-- ══════ RIGHT: scan + overlay ══════ -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid Margin="0,0,0,10">
                            <StackPanel Margin="0,0,120,0">
                                <TextBlock Text="{local:L scan.title}" Style="{StaticResource SectionTitle}"/>
                                <TextBlock x:Name="ScanHint" Style="{StaticResource Muted}" Margin="0,2,0,0"/>
                            </StackPanel>
                            <Button x:Name="ScanButton" Style="{StaticResource AccentAction}"
                                    HorizontalAlignment="Right" VerticalAlignment="Top" MinWidth="96"
                                    Click="ScanButton_Click"/>
                        </Grid>
                        <Border Grid.Row="1" Background="{StaticResource PoInner}" CornerRadius="10">
                            <Grid>
                                <TextBlock x:Name="ScanEmpty" Style="{StaticResource Muted}" Margin="16"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center"/>
                                <ListBox x:Name="ScanList" Background="Transparent" BorderThickness="0"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                         SelectionChanged="ScanList_SelectionChanged"
                                         MouseDoubleClick="ScanList_MouseDoubleClick">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="2,4">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text="{Binding Id}" FontSize="11" Foreground="{StaticResource PoMuted}"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Border Style="{StaticResource Chip}" Padding="7,2" Margin="0,0,6,0"
                                                            Visibility="{Binding SavedVisibility}">
                                                        <TextBlock Text="{local:L scan.saved}" FontSize="11"/>
                                                    </Border>
                                                    <Border Style="{StaticResource Chip}" Padding="7,2" Margin="0,0,8,0"
                                                            Background="#33FF3B5C" Visibility="{Binding HeartRateVisibility}">
                                                        <TextBlock Text="{local:L scan.hr}" FontSize="11" Foreground="#FF8DA1"/>
                                                    </Border>
                                                    <TextBlock Text="{Binding SignalText}" FontSize="12" Width="34"
                                                               Foreground="{StaticResource PoMuted}" ToolTip="{Binding Rssi}"/>
                                                </StackPanel>
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Grid>
                        </Border>
                        <Grid Grid.Row="2" Margin="0,12,0,0">
                            <CheckBox x:Name="ShowAllDevices" Content="{local:L scan.showAll}" FontSize="12"
                                      VerticalAlignment="Center" Checked="ShowAllDevices_Changed"
                                      Unchecked="ShowAllDevices_Changed"/>
                            <Button x:Name="ConnectButton" Content="{local:L scan.connect}" Style="{StaticResource AccentAction}"
                                    HorizontalAlignment="Right" MinWidth="96" IsEnabled="False"
                                    Click="ConnectSelected_Click"/>
                        </Grid>
                    </Grid>
                </Border>

                <!-- Overlay -->
                <Border Grid.Row="1" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="{local:L overlay.title}" Style="{StaticResource SectionTitle}"/>
                        <TextBlock Text="{local:L overlay.howto}" Style="{StaticResource Muted}" Margin="0,2,0,10"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="UrlBox" IsReadOnly="True" Text="—" FontFamily="Cascadia Mono, Consolas"
                                     VerticalContentAlignment="Center"/>
                            <Button Grid.Column="1" Content="{local:L overlay.copy}" Margin="8,0,0,0" Click="CopyUrl_Click"/>
                        </Grid>
                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                            <Button Content="{local:L overlay.customize}" Style="{StaticResource AccentAction}"
                                    Click="OpenEditor_Click" ToolTip="{local:L overlay.customize.tip}"/>
                            <Button Content="{local:L overlay.openBrowser}" Margin="8,0,0,0" Click="OpenOverlay_Click"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>

        <!-- ══════ STATUS BAR ══════ -->
        <TextBlock x:Name="StatusText" Grid.Row="2" Style="{StaticResource Muted}" Margin="2,14,0,0"
                   TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" Text="{local:L status.preparing}"/>
    </Grid>
</Window>
